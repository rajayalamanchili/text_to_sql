# Local Docker Compose dev environment only — synthetic data, no real
# credentials belong here or in .env. Copy to .env and fill in your own
# local-only values (docker-compose.yml will refuse to start without them).

HEALTHCARE_DB_USER=
HEALTHCARE_DB_PASSWORD=
HEALTHCARE_DB_NAME=
HEALTHCARE_DB_PORT=5432

FINTECH_DB_USER=
FINTECH_DB_PASSWORD=
FINTECH_DB_NAME=
FINTECH_DB_PORT=5433

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Comma-separated origins the backend's CORS middleware allows (defaults to
# http://localhost:3000, the frontend's local dev origin, if unset).
STEWARD_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional. Unset uses NullLLMClient (anthropic_client.py) instead of a real
# LLM-assisted classification pass — see quickstart.md step 1/3 for what
# that changes about which columns land in pending_review.
ANTHROPIC_API_KEY=
